<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MauiAppMinhasCompras.Views.NovoProduto"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Novo Produto">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Descrição" FontAttributes="Bold" />
        <Entry x:Name="DescricaoEntry" Placeholder="Ex: Cadeira de escritório" />

        <Label Text="Quantidade" FontAttributes="Bold" />
        <Entry x:Name="QuantidadeEntry" Placeholder="Ex: 1" Keyboard="Numeric" />

        <Label Text="Preço" FontAttributes="Bold" />
        <Entry x:Name="PrecoEntry" Placeholder="Ex: 199.90" Keyboard="Numeric" />

        <Button Text="Salvar" Clicked="OnSalvarClicked" Margin="0,20,0,0" />
    </VerticalStackLayout>

</ContentPage>