<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="MauiAppMinhasCompras.Views.EditarProduto"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Editar Produto">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Descrição" FontAttributes="Bold" />
        <Entry x:Name="DescricaoEntry" />

        <Label Text="Quantidade" FontAttributes="Bold" />
        <Entry x:Name="QuantidadeEntry" Keyboard="Numeric" />

        <Label Text="Preço" FontAttributes="Bold" />
        <Entry x:Name="PrecoEntry" Keyboard="Numeric" />

        <Button Text="Salvar Alterações" Clicked="OnSalvarClicked" Margin="0,20,0,0" />
        <Button Text="Excluir Produto" Clicked="OnExcluirClicked" BackgroundColor="IndianRed" TextColor="White" />
    </VerticalStackLayout>

</ContentPage>